{
    "name": "blapos/blapos",
    "type": "project",
    "description": "Blapos multi-tenant business management platform.",
    "keywords": ["blapos", "saas", "multi-tenant", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "barryvdh/laravel-dompdf": "^3.0",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^1.27",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format:php": [
            "@php scripts/format-php-double-quotes.php",
            "@php scripts/format-php-control-structures.php",
            "@php vendor/bin/pint"
        ],
        "format:php-check": [
            "@php scripts/format-php-double-quotes.php --check",
            "@php scripts/format-php-control-structures.php --check",
            "@php vendor/bin/pint --test"
        ],
        "check:php-syntax": [
            "@php scripts/check-php-syntax.php"
        ],
        "check:tenant-boundary": [
            "@php artisan test tests/Unit/Architecture/TenantCompanyBoundaryTest.php tests/Unit/Architecture/TenantRuntimeArchitectureTest.php tests/Unit/Services/TenantRuntimeContextTest.php tests/Feature/BranchContextTest.php tests/Feature/TenantCompanyDatabaseBoundaryTest.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
