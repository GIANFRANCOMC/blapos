APP_NAME=Blapos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://demo.blapos.test
COMPANY_ID=1

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blapos
DB_USERNAME=root
DB_PASSWORD=

# Multi-tenant
LANDLORD_DB_CONNECTION=landlord
LANDLORD_DB_HOST=${DB_HOST}
LANDLORD_DB_PORT=${DB_PORT}
LANDLORD_DB_DATABASE=blapos_landlord
LANDLORD_DB_USERNAME=${DB_USERNAME}
LANDLORD_DB_PASSWORD=${DB_PASSWORD}

TENANT_DB_CONNECTION=tenant
TENANT_DB_HOST=${DB_HOST}
TENANT_DB_PORT=${DB_PORT}
TENANT_DB_USERNAME=${DB_USERNAME}
TENANT_DB_PASSWORD=${DB_PASSWORD}
TENANT_DB_PREFIX=blapos_tenant_
TENANT_ENFORCE_DB_PREFIX=true
TENANT_BACKUP_DISK=local
TENANT_BACKUP_RETENTION=10
TENANT_BACKUP_TIMEOUT=900
MYSQL_DUMP_BINARY=mysqldump
MYSQL_CLIENT_BINARY=mysql
TENANT_SESSION_COOKIE_PREFIX=blapos_tenant
TENANCY_BASE_DOMAIN=blapos.test
TENANCY_PLATFORM_SUBDOMAIN=app
TENANCY_ENFORCE_SUBDOMAINS=true
TENANCY_RESERVED_SUBDOMAINS=www,api,admin,app,mail,static,assets
TENANCY_RESOLVER_CACHE_SECONDS=60
PLATFORM_SESSION_COOKIE=blapos_platform_session
PLATFORM_ADMIN_NAME="Administrador SaaS"
PLATFORM_ADMIN_EMAIL=admin@app.blapos.test
PLATFORM_ADMIN_PASSWORD=Admin12345!

# Security
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_DOMAIN=
SESSION_EXPIRE_ON_CLOSE=false
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Config
CAPTCHA_ENABLED=false
CAPTCHA_KEY_FRONTEND=""
CAPTCHA_KEY_BACKEND=""
CAPTCHA_TIMEOUT_SECONDS=5

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=testblapostestblapos@gmail.com
MAIL_FROM_NAME="Test Blapos / User"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
